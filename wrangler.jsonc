{
	"compatibility_date": "2026-03-17",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "akinozgen-portfolio",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// Anything that is not a file gets the static 404 page. Without this
		// every miss - mostly bots probing for .env and wp-login.php - would
		// run the Worker and count against its daily quota.
		"not_found_handling": "404-page"
	},
	"observability": {
		"enabled": true
	}
}