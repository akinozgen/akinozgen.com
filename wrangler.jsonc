{
	"compatibility_date": "2026-03-17",
	"compatibility_flags": ["global_fetch_strictly_public"],
	// The Worker as Cloudflare knows it (akinozgen.com is its custom domain); Workers Builds deploys under this name.
	"name": "akinozgencom",
	// Astro's handler, wrapped so harfiyen's online play can export its Durable Objects.
	"main": "./src/worker.ts",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// The site is static: only /api/* needs the Worker. Everything else is
		// served from assets, and a miss gets 404.html. Without these two, each
		// miss - mostly bots probing for .env and wp-login.php - ran the Worker
		// and counted against its daily quota.
		// /__/auth/* is Firebase's sign-in helper, passed through to Firebase (see
		// games/packages/account/src/server/worker/proxy.ts).
		"run_worker_first": ["/api/*", "/__/*"],
		"not_found_handling": "404-page"
	},
	// Game data too big or too numerous for git: vexle's tile packs.
	"r2_buckets": [
		{
			"binding": "GAME_ASSETS",
			"bucket_name": "akinozgen-games"
		}
	],
	// Accounts shared by every game (games/packages/account), and what they keep.
	// Tables come from migrations/: `npx wrangler d1 migrations apply akinozgen-hesap --remote`.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "akinozgen-hesap",
			"database_id": "01763c06-ee0b-4e8a-b574-63f1a1814e7d",
			"migrations_dir": "migrations"
		}
	],
	"observability": {
		"enabled": true
	},
	// harfiyen online: one Durable Object per room, one lobby. SQLite-backed,
	// which the Workers Free plan allows; nothing here is billed on Free, past
	// a limit requests just fail until the next day.
	"durable_objects": {
		"bindings": [
			{ "name": "HARFIYEN_ROOM", "class_name": "HarfiyenRoom" },
			{ "name": "HARFIYEN_LOBBY", "class_name": "HarfiyenLobby" }
		]
	},
	"migrations": [{ "tag": "harfiyen-v1", "new_sqlite_classes": ["HarfiyenRoom", "HarfiyenLobby"] }],
	// "off" closes online play (503) without touching the code.
	"vars": { "HARFIYEN_MP": "on" }
}