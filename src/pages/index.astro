---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPortfolioData } from "../lib/github";
import Icon from "../components/Icon.astro";
import ImageSlider from "../components/ImageSlider.astro";
import Nav from "../components/Nav.astro";
import { packages } from "../data/packages";
import { skillGroups } from "../data/skills";
import { games } from "../data/games";
import { workHistory, education, certificates } from "../data/history";

const { profile, projects } = getPortfolioData();
const displayName = profile.name ?? profile.login;
---

<BaseLayout
  title={displayName + ' - Portfolio'}
  description={`Personal site of ${displayName} — software developer building tools, utilities, and open source experiments.`}
>
  <Nav name={displayName} githubUrl={profile.html_url} />
  <main class="page-shell">
    <section class="hero">
      <div class="hero-left">
        <p class="eyebrow">Software Developer</p>
        <h1>{displayName}</h1>
        <p class="lead">
          Professionally I work on backends, service integrations, and database-heavy systems —
          mostly in the ISP and networking space. Lately my side projects lean lower-level and
          native: console homebrew, cross-platform apps, and small desktop tools.
        </p>
        <div class="hero-links">
          <a href={profile.html_url} target="_blank" rel="noreferrer">
            <Icon name="github" size={18} /> GitHub
          </a>
        </div>
      </div>
      <div class="hero-right">
        <a class="stat-card" href="https://github.com/akinozgen/navicloud" target="_blank" rel="noreferrer">
          <p class="stat-label">current focus</p>
          <p class="stat-pkg">NaviCloud</p>
          <p class="stat-number">Navidrome client · Android + Windows</p>
        </a>
        <a class="stat-card stat-card--project" href="https://github.com/akinozgen/fallout1-ce-ps3" target="_blank" rel="noreferrer">
          <p class="stat-label">current focus</p>
          <p class="stat-pkg">Fallout 1 CE — PS3</p>
          <p class="stat-number">Native PS3 homebrew port</p>
        </a>
      </div>
    </section>

    <section id="experience" class="section-block">
      <div class="section-heading">
        <h2>Experience</h2>
      </div>

      <div class="exp-timeline">
        {workHistory.map((job) => (
          <div class={`exp-row${job.current ? " exp-row--current" : ""}`}>
            <div class="exp-period">
              {job.current && <span class="exp-now">NOW</span>}
              {job.period}
            </div>
            <div class="exp-body">
              <div class="exp-header">
                <span class="exp-company">
                  {job.url
                    ? <a href={job.url} target="_blank" rel="noreferrer">{job.company} ↗</a>
                    : job.company}
                </span>
                <span class="exp-role">{job.role}</span>
              </div>
              <p class="exp-desc">{job.description}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="edu-certs-grid">
        <div class="edu-block">
          <p class="exp-sub-label">Education</p>
          {education.map((e) => (
            <div class="edu-row">
              <span class="edu-period">{e.period}</span>
              <div class="edu-body">
                <span class="edu-institution">{e.institution}</span>
                <span class="edu-field">{e.field}</span>
              </div>
            </div>
          ))}
        </div>

        <div class="cert-block">
          <p class="exp-sub-label">Certificates</p>
          <div class="cert-grid">
            {certificates.map((cert) => (
              <div class="cert-card">
                <p class="cert-name">{cert.name}</p>
                <p class="cert-id">{cert.id}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="work" class="section-block">
      <div class="section-heading">
        <h2>Work</h2>
      </div>
      <div class="project-grid">
        {projects.map((project) => (
          <article class={`project-card${project.featured ? " project-card--featured" : ""}`}>
            <ImageSlider images={project.images} alt={`${project.name} preview`} />
            <div class="card-topline">
              <span>{project.language ?? "Project"}</span>
              {project.stars > 0 && (
                <span class="star-count"><Icon name="star" size={13} />{project.stars}</span>
              )}
            </div>
            <h3>{project.name}</h3>
            <p class="subtitle">{project.subtitle}</p>
            <p>{project.description}</p>
            <div class="tag-row">
              {project.topics.slice(0, 4).map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
            <div class="card-links">
              <a href={project.githubUrl} target="_blank" rel="noreferrer">
                <Icon name="github" size={14} /> Repo
              </a>
              {project.homepageUrl && (
                <a href={project.homepageUrl} target="_blank" rel="noreferrer">
                  <Icon name="external" size={14} /> Live
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="packages" class="section-block">
      <div class="section-heading">
        <h2>Packages</h2>
      </div>
      <div class="pkg-grid">
        {packages.map((pkg) => (
          <article class="pkg-card">
            <div class="pkg-topline">
              <span>{pkg.language}</span>
              <span>{pkg.totalDownloads > 0 ? `${pkg.totalDownloads.toLocaleString("en-US")} downloads` : "just released"}</span>
            </div>
            <h3>{pkg.name}</h3>
            <p>{pkg.description}</p>
            <div class="pkg-footer">
              <span class="pkg-version">v{pkg.version}</span>
              <div class="card-links">
                <a href={pkg.githubUrl} target="_blank" rel="noreferrer">
                  <Icon name="github" size={13} /> Repo
                </a>
                <a href={pkg.npmUrl} target="_blank" rel="noreferrer">
                  <Icon name="external" size={13} /> npm
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>
    <section id="skills" class="section-block skills-section">
      <div class="section-heading">
        <h2>Skills</h2>
      </div>
      {skillGroups.map((group, gi) => (
        <div class="skill-group">
          <p class="skill-category">{group.category}</p>
          {group.skills.map((skill, i) => (
            <div class="skill-row">
              <span class="skill-index">{String(i + 1).padStart(2, "0")}</span>
              <span class="skill-name">{skill}</span>
            </div>
          ))}
          {gi === skillGroups.length - 1 && (
            <button
              type="button"
              class="skill-row skill-row--egg"
              id="egg-trigger"
              aria-expanded="false"
              aria-controls="receipt"
            >
              <span class="skill-index">{String(group.skills.length + 1).padStart(2, "0")}</span>
              <span class="skill-name">Procrastination</span>
            </button>
          )}
        </div>
      ))}

      <div class="receipt" id="receipt" aria-hidden="true">
        <div class="receipt-paper">
          <div class="receipt-sheet">
            <p class="rcpt-line rcpt-head">AKIN OZGEN</p>
            <p class="rcpt-line rcpt-sub">time wasted — receipt</p>
            <p class="rcpt-line rcpt-meta">
              <span data-rcpt-date>··.··.····</span>
              <span data-rcpt-time>··:··</span>
              <span data-rcpt-no>#······</span>
            </p>
            <hr class="rcpt-line rcpt-rule" />
            {games.map((game) => (
              <a class="rcpt-line rcpt-item" href={`/games/${game.slug}/`}>
                <span class="rcpt-item-row">
                  <span class="rcpt-item-name">{game.name}</span>
                  <span class="rcpt-item-dots" aria-hidden="true"></span>
                  <span class="rcpt-item-year">{game.year}</span>
                </span>
                <span class="rcpt-item-note">{game.tagline}</span>
              </a>
            ))}
            <hr class="rcpt-line rcpt-rule" />
            <p class="rcpt-line rcpt-total"><span>items</span><span>{games.length}</span></p>
            <p class="rcpt-line rcpt-total"><span>productivity</span><span>0.00</span></p>
            <hr class="rcpt-line rcpt-rule" />
            <p class="rcpt-line rcpt-thanks">thank you for<br />not working</p>
            <a class="rcpt-line rcpt-all" href="/games">all items → /games</a>
            <div class="rcpt-line rcpt-barcode" aria-hidden="true"></div>
          </div>
        </div>
      </div>
    </section>

    <section id="contact" class="section-block">
      <div class="section-heading">
        <h2>Contact</h2>
      </div>
      <div class="contact-list">
        <a class="contact-row" href="mailto:akinozgen@protonmail.com?subject=Hey%20from%20your%20portfolio">
          <span class="contact-label">Proton</span>
          <span class="contact-value">akinozgen@protonmail.com</span>
          <span class="contact-arrow">↗</span>
        </a>
        <a class="contact-row" href="mailto:akinozgen17@outlook.com?subject=Hey%20from%20your%20portfolio">
          <span class="contact-label">Outlook</span>
          <span class="contact-value">akinozgen17@outlook.com</span>
          <span class="contact-arrow">↗</span>
        </a>
        <a class="contact-row" href="https://www.linkedin.com/in/akinozgen/" target="_blank" rel="noreferrer">
          <span class="contact-label">LinkedIn</span>
          <span class="contact-value">linkedin.com/in/akinozgen</span>
          <span class="contact-arrow">↗</span>
        </a>
      </div>
    </section>
  </main>

<div id="lightbox" aria-hidden="true">
  <img id="lightbox-img" src="" alt="" />
</div>

<script>
  const lightbox = document.getElementById('lightbox')!;
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;

  document.addEventListener('click', (e) => {
    const img = (e.target as Element).closest<HTMLImageElement>('[data-zoomable]');
    if (!img) return;
    lightboxImg.src = img.src;
    lightboxImg.alt = img.alt;
    lightbox.classList.add('open');
    document.body.style.overflow = 'hidden';
  });

  lightbox.addEventListener('click', () => {
    lightbox.classList.remove('open');
    document.body.style.overflow = '';
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      lightbox.classList.remove('open');
      document.body.style.overflow = '';
    }
  });
</script>
<script>
  const trigger = document.getElementById('egg-trigger');
  const receipt = document.getElementById('receipt');
  const sheet = receipt?.querySelector<HTMLElement>('.receipt-sheet');

  if (trigger && receipt && sheet) {
    receipt.querySelectorAll<HTMLElement>('.rcpt-line').forEach((el, i) => {
      el.style.setProperty('--i', String(i));
    });

    // torn top edge (where the previous receipt was ripped off): one tooth every 4% of the width
    const teeth: string[] = ['0 100%', '100% 100%'];
    for (let x = 100; x > 0; x -= 4) {
      teeth.push(`${x}% 7px`, `${x - 2}% 0`);
    }
    teeth.push('0 7px');
    sheet.style.clipPath = `polygon(${teeth.join(', ')})`;

    const setOpen = (open: boolean) => {
      receipt.classList.toggle('printed', open);
      trigger.setAttribute('aria-expanded', String(open));
      receipt.setAttribute('aria-hidden', String(!open));
      if (!open) return;

      const now = new Date();
      const pad = (n: number) => String(n).padStart(2, '0');
      receipt.querySelector('[data-rcpt-date]')!.textContent =
        `${pad(now.getDate())}.${pad(now.getMonth() + 1)}.${now.getFullYear()}`;
      receipt.querySelector('[data-rcpt-time]')!.textContent = `${pad(now.getHours())}:${pad(now.getMinutes())}`;
      receipt.querySelector('[data-rcpt-no]')!.textContent = '#' + String(now.getTime()).slice(-6);
    };

    trigger.addEventListener('click', () => setOpen(!receipt.classList.contains('printed')));

    document.addEventListener('click', (e) => {
      if (!receipt.classList.contains('printed')) return;
      const t = e.target as Element;
      if (receipt.contains(t) || trigger.contains(t)) return;
      setOpen(false);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && receipt.classList.contains('printed')) setOpen(false);
    });
  }
</script>
</BaseLayout>
