---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPortfolioData } from "../lib/github";
import Icon from "../components/Icon.astro";
import ImageSlider from "../components/ImageSlider.astro";
import Nav from "../components/Nav.astro";
import { packages } from "../data/packages";
import { skillGroups } from "../data/skills";
import { workHistory, education, certificates } from "../data/history";

const { profile, projects } = getPortfolioData();
const displayName = profile.name ?? profile.login;
---

<BaseLayout
  title={displayName + ' - Portfolio'}
  description={`Personal site of ${displayName} — software developer building tools, utilities, and open source experiments.`}
>
  <Nav name={displayName} githubUrl={profile.html_url} />
  <main class="page-shell">
    <section class="hero">
      <p class="eyebrow">Software developer</p>
      <h1>{displayName}</h1>
      <p class="lead">
        Professionally I work on backends, service integrations, and database-heavy systems —
        mostly in the ISP and networking space. Lately my side projects lean lower-level and
        native: console homebrew, cross-platform apps, and small desktop tools.
      </p>
      <div class="now">
        <span class="now-label">Currently building</span>
        <a href="https://github.com/akinozgen/navicloud" target="_blank" rel="noreferrer">
          NaviCloud <span class="now-desc">— Navidrome client for Android + Windows</span>
        </a>
        <a href="https://github.com/akinozgen/fallout1-ce-ps3" target="_blank" rel="noreferrer">
          Fallout 1 CE on PS3 <span class="now-desc">— native homebrew port</span>
        </a>
      </div>
      <div class="hero-links">
        <a href={profile.html_url} target="_blank" rel="noreferrer">
          <Icon name="github" size={16} /> GitHub
        </a>
      </div>
    </section>

    <section id="experience" class="section-block">
      <div class="section-heading">
        <h2>Experience</h2>
      </div>

      <div class="exp-timeline">
        {workHistory.map((job) => (
          <div class={`exp-row${job.current ? " exp-row--current" : ""}`}>
            <div class="exp-period">
              {job.current && <span class="exp-now">current</span>}
              {job.period}
            </div>
            <div class="exp-body">
              <div class="exp-header">
                <span class="exp-company">
                  {job.url
                    ? <a href={job.url} target="_blank" rel="noreferrer">{job.company} ↗</a>
                    : job.company}
                </span>
                <span class="exp-role">{job.role}</span>
              </div>
              <p class="exp-desc">{job.description}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="edu-certs-grid">
        <div class="edu-block">
          <p class="exp-sub-label">Education</p>
          {education.map((e) => (
            <div class="edu-row">
              <span class="edu-period">{e.period}</span>
              <div class="edu-body">
                <span class="edu-institution">{e.institution}</span>
                <span class="edu-field">{e.field}</span>
              </div>
            </div>
          ))}
        </div>

        <div class="cert-block">
          <p class="exp-sub-label">Certificates</p>
          <div class="cert-grid">
            {certificates.map((cert) => (
              <div class="cert-card">
                <p class="cert-name">{cert.name}</p>
                <p class="cert-id">{cert.id}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="work" class="section-block">
      <div class="section-heading">
        <h2>Work</h2>
      </div>
      <div class="project-grid">
        {projects.map((project) => (
          <article class={`project-card${project.images.length === 0 ? " project-card--text" : ""}`}>
            <div class="project-info">
              <div class="project-head">
                <h3>{project.name}</h3>
                <span class="project-meta">
                  <span>{project.language ?? "Project"}</span>
                  {project.stars > 0 && (
                    <span class="star-count"><Icon name="star" size={12} />{project.stars}</span>
                  )}
                </span>
              </div>
              <p class="subtitle">{project.subtitle}</p>
              <p class="project-desc">{project.description}</p>
              <div class="card-links">
                <a href={project.githubUrl} target="_blank" rel="noreferrer">
                  <Icon name="github" size={13} /> Repo
                </a>
                {project.homepageUrl && (
                  <a href={project.homepageUrl} target="_blank" rel="noreferrer">
                    <Icon name="external" size={13} /> Live
                  </a>
                )}
              </div>
            </div>
            {project.images.length > 0 && (
              <div class="project-media">
                <ImageSlider images={project.images} alt={`${project.name} preview`} />
              </div>
            )}
          </article>
        ))}
      </div>
    </section>

    <section id="packages" class="section-block">
      <div class="section-heading">
        <h2>Packages</h2>
      </div>
      <div class="pkg-grid">
        {packages.map((pkg) => (
          <article class="pkg-row">
            <div class="pkg-left">
              <a class="pkg-name" href={pkg.npmUrl} target="_blank" rel="noreferrer">{pkg.name}</a>
              <span class="pkg-sub">v{pkg.version} · <a href={pkg.githubUrl} target="_blank" rel="noreferrer">repo</a></span>
            </div>
            <p class="pkg-desc">{pkg.description}</p>
            <span class="pkg-dl">{pkg.totalDownloads > 0 ? `${pkg.totalDownloads.toLocaleString("en-US")} downloads` : "just released"}</span>
          </article>
        ))}
      </div>
    </section>
    <section id="skills" class="section-block skills-section">
      <div class="section-heading">
        <h2>Skills</h2>
      </div>
      {skillGroups.map((group) => (
        <div class="skill-line">
          <span class="skill-cat">{group.category}</span>
          <p class="skill-list">{group.skills.join(" · ")}</p>
        </div>
      ))}
    </section>

    <section id="contact" class="section-block">
      <div class="section-heading">
        <h2>Contact</h2>
      </div>
      <div class="contact-list">
        <a class="contact-row" href="mailto:akinozgen@protonmail.com?subject=Hey%20from%20your%20portfolio">
          <span class="contact-label">Proton</span>
          <span class="contact-value">akinozgen@protonmail.com</span>
          <span class="contact-arrow">↗</span>
        </a>
        <a class="contact-row" href="mailto:akinozgen17@outlook.com?subject=Hey%20from%20your%20portfolio">
          <span class="contact-label">Outlook</span>
          <span class="contact-value">akinozgen17@outlook.com</span>
          <span class="contact-arrow">↗</span>
        </a>
        <a class="contact-row" href="https://www.linkedin.com/in/akinozgen/" target="_blank" rel="noreferrer">
          <span class="contact-label">LinkedIn</span>
          <span class="contact-value">linkedin.com/in/akinozgen</span>
          <span class="contact-arrow">↗</span>
        </a>
      </div>
    </section>
  </main>

<div id="lightbox" aria-hidden="true">
  <img id="lightbox-img" src="" alt="" />
</div>

<script>
  const lightbox = document.getElementById('lightbox')!;
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;

  document.addEventListener('click', (e) => {
    const img = (e.target as Element).closest<HTMLImageElement>('[data-zoomable]');
    if (!img) return;
    lightboxImg.src = img.src;
    lightboxImg.alt = img.alt;
    lightbox.classList.add('open');
    document.body.style.overflow = 'hidden';
  });

  lightbox.addEventListener('click', () => {
    lightbox.classList.remove('open');
    document.body.style.overflow = '';
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      lightbox.classList.remove('open');
      document.body.style.overflow = '';
    }
  });
</script>
</BaseLayout>
